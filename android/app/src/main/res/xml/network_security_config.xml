<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP local (dev): permite cualquier IP; en producción usar HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
