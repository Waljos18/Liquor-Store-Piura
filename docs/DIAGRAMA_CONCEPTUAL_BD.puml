@startuml
!theme plain
title Diagrama Conceptual de Base de Datos\nSistema POS/ERP - Licoreria Chilalo

left to right direction
hide methods
hide stereotypes
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #F8FBFF
  BorderColor #2F5597
  ArrowColor #555555
}

entity "USUARIOS" as usuarios {
  * id : PK
  --
  username
  email
  nombre
  rol
  activo
}

entity "CLIENTES" as clientes {
  * id : PK
  --
  tipo_documento
  numero_documento
  nombre
  telefono
  puntos_fidelizacion
}

entity "CATEGORIAS" as categorias {
  * id : PK
  --
  nombre
  descripcion
  activa
}

entity "PRODUCTOS" as productos {
  * id : PK
  --
  codigo_barras
  nombre
  marca
  precio_compra
  precio_venta
  stock_actual
  stock_minimo
  fecha_vencimiento
  activo
}

entity "VENTAS" as ventas {
  * id : PK
  --
  numero_venta
  fecha
  subtotal
  descuento
  impuesto
  total
  forma_pago
  estado
}

entity "DETALLE_VENTAS" as detalle_ventas {
  * id : PK
  --
  cantidad
  precio_unitario
  descuento
  subtotal
}

entity "VENTA_PAGOS" as venta_pagos {
  * id : PK
  --
  metodo_pago
  monto
  referencia
}

entity "COMPROBANTES_ELECTRONICOS" as comprobantes {
  * id : PK
  --
  tipo_comprobante
  serie
  numero
  estado_sunat
  fecha_emision
}

entity "PROVEEDORES" as proveedores {
  * id : PK
  --
  razon_social
  ruc
  telefono
  email
  activo
}

entity "COMPRAS" as compras {
  * id : PK
  --
  numero_compra
  fecha
  total
  estado
  fecha_recepcion
}

entity "DETALLE_COMPRAS" as detalle_compras {
  * id : PK
  --
  cantidad
  precio_unitario
  subtotal
  cantidad_recibida
}

entity "MOVIMIENTOS_INVENTARIO" as movimientos {
  * id : PK
  --
  tipo_movimiento
  cantidad
  motivo
  fecha
}

entity "PROMOCIONES" as promociones {
  * id : PK
  --
  nombre
  tipo
  descuento_porcentaje
  descuento_monto
  fecha_inicio
  fecha_fin
  activa
}

entity "PROMOCION_PRODUCTOS" as promocion_productos {
  * id : PK
  --
  cantidad_minima
  cantidad_gratis
}

entity "PACKS" as packs {
  * id : PK
  --
  nombre
  precio_pack
  activo
}

entity "PACK_PRODUCTOS" as pack_productos {
  * id : PK
  --
  cantidad
}

entity "DEVOLUCIONES" as devoluciones {
  * id : PK
  --
  numero_devolucion
  motivo
  estado
  total
  fecha_creacion
}

entity "DETALLE_DEVOLUCIONES" as detalle_devoluciones {
  * id : PK
  --
  cantidad
  precio_unitario
  subtotal
}

entity "CUENTAS_POR_COBRAR" as cuentas_por_cobrar {
  * id : PK
  --
  monto_total
  monto_pagado
  saldo_pendiente
  estado
  fecha_vencimiento
}

entity "PAGOS_CUENTA" as pagos_cuenta {
  * id : PK
  --
  monto
  fecha
  forma_pago
}

entity "APERTURAS_CAJA" as aperturas_caja {
  * id : PK
  --
  fecha
  hora_apertura
  hora_cierre
  monto_inicial
  monto_cierre
  monto_real
  sobrante_faltante
  estado
}

entity "GASTOS" as gastos {
  * id : PK
  --
  descripcion
  categoria
  monto
  fecha
}

entity "MERMAS" as mermas {
  * id : PK
  --
  cantidad
  motivo
  descripcion
  valor_perdida
  fecha
}

entity "CONFIG_FIDELIZACION" as config_fidelizacion {
  * id : PK
  --
  soles_por_punto
  puntos_sol_descuento
  max_puntos_canje
  min_compra_canje
  activo
}

entity "PUNTOS_MOVIMIENTOS" as puntos_movimientos {
  * id : PK
  --
  tipo
  cantidad
  saldo_despues
  motivo
  fecha
}

entity "PASSWORD_RESET_TOKENS" as password_reset_tokens {
  * id : PK
  --
  token
  expira_en
  usado
  creado_en
}

categorias ||--o{ productos
usuarios ||--o{ ventas
clientes ||--o{ ventas
ventas ||--o{ detalle_ventas
productos ||--o{ detalle_ventas
packs ||--o{ detalle_ventas
ventas ||--o{ venta_pagos
ventas ||--o{ comprobantes

proveedores ||--o{ compras
usuarios ||--o{ compras
compras ||--o{ detalle_compras
productos ||--o{ detalle_compras

productos ||--o{ movimientos
usuarios ||--o{ movimientos
ventas ||--o{ movimientos
compras ||--o{ movimientos

promociones ||--o{ promocion_productos
productos ||--o{ promocion_productos
packs ||--o{ pack_productos
productos ||--o{ pack_productos

ventas ||--o{ devoluciones
usuarios ||--o{ devoluciones
devoluciones ||--o{ detalle_devoluciones
productos ||--o{ detalle_devoluciones

ventas ||--|| cuentas_por_cobrar
clientes ||--o{ cuentas_por_cobrar
cuentas_por_cobrar ||--o{ pagos_cuenta
usuarios ||--o{ pagos_cuenta

usuarios ||--o{ aperturas_caja : apertura
usuarios ||--o{ aperturas_caja : cierre
usuarios ||--o{ gastos
productos ||--o{ mermas
usuarios ||--o{ mermas

clientes ||--o{ puntos_movimientos
ventas ||--o{ puntos_movimientos
usuarios ||--o{ puntos_movimientos

usuarios ||--o{ password_reset_tokens

note bottom of config_fidelizacion
  Parametriza la logica
  de fidelizacion del sistema.
end note

@enduml
